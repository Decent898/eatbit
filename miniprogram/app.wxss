page {
  min-height: 100%;
  color: #17201c;
  background: #f7faf8;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  --button-primary-background-color: #18a058;
  --button-primary-border-color: #18a058;
  --button-default-border-color: #dce7e1;
  --button-default-color: #176049;
  --cell-background-color: #ffffff;
  --cell-group-background-color: #ffffff;
  --cell-group-title-color: #718078;
  --tag-primary-color: #18a058;
  --tag-danger-color: #d03050;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  font: inherit;
  line-height: inherit;
  text-align: center;
  box-sizing: border-box;
}

button::after {
  border: 0;
}

.page {
  padding: 24rpx 24rpx 56rpx;
  box-sizing: border-box;
}

.card {
  margin-bottom: 22rpx;
  padding: 24rpx;
  border: 1rpx solid #e4ece7;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(23, 32, 28, 0.04);
  box-sizing: border-box;
}

.van-card {
  overflow: hidden;
  margin-bottom: 22rpx;
  border: 1rpx solid #e4ece7;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(23, 32, 28, 0.04);
}

.van-card .van-cell,
.van-card .van-cell-group {
  background: #ffffff;
}

.hero {
  margin-bottom: 22rpx;
  padding: 36rpx 32rpx;
  border-radius: 22rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #18a058, #1f7a61);
  box-shadow: 0 14rpx 32rpx rgba(24, 160, 88, .18);
}

.hero-title {
  font-size: 42rpx;
  line-height: 1.25;
  font-weight: 800;
}

.hero-subtitle {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.86);
  line-height: 1.55;
}

.row {
  display: flex;
  align-items: center;
}

.between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-width: 0;
}

.between > view {
  min-width: 0;
}

.wrap {
  flex-wrap: wrap;
}

.muted {
  color: #718078;
  font-size: 24rpx;
  line-height: 1.45;
}

.title {
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.3;
}

.section-title {
  margin: 34rpx 0 16rpx;
  font-size: 32rpx;
  font-weight: 800;
}

.section-title::before {
  display: inline-block;
  width: 8rpx;
  height: 28rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: #18a058;
  vertical-align: -4rpx;
  content: "";
}

.tag {
  display: inline-flex;
  margin-right: 10rpx;
  margin-bottom: 8rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #176049;
  background: #eaf7f0;
  font-size: 22rpx;
}

.van-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.van-tags van-tag {
  margin-bottom: 2rpx;
}

.tag.warn {
  color: #b54708;
  background: #fff4e5;
}

.tag.error {
  color: #c03221;
  background: #ffeceb;
}

.score {
  color: #18a058;
  font-size: 34rpx;
  font-weight: 900;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 68rpx;
  min-width: 168rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: #18a058;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.2;
  box-sizing: border-box;
}

.button-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 14rpx;
}

.button-row.left {
  justify-content: flex-start;
}

.button-row.right {
  justify-content: flex-end;
}

.btn:active {
  transform: scale(.98);
  opacity: .86;
}

.btn.mini {
  min-height: 56rpx;
  padding: 0 18rpx;
  font-size: 24rpx;
}

.btn.secondary {
  color: #176049;
  background: #eaf7f0;
}

.btn.ghost {
  color: #18a058;
  background: transparent;
}

.btn.danger {
  color: #c03221;
  background: #ffeceb;
}

.input,
.textarea,
.select {
  width: 100%;
  min-height: 88rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #d9e2dd;
  border-radius: 18rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.textarea {
  min-height: 160rpx;
  line-height: 1.55;
}

.select {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #17201c;
}

.select::after {
  color: #8a9790;
  font-size: 34rpx;
  content: ">";
}

.input:focus,
.textarea:focus {
  border-color: #18a058;
}

.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  align-items: center;
  justify-items: center;
}

.grid-2 .btn {
  width: min(100%, 260rpx);
}

.empty {
  padding: 44rpx 20rpx;
  color: #8a9790;
  text-align: center;
}

.link-card {
  transition: opacity .15s ease;
}

.link-card:active {
  transform: scale(.992);
  opacity: .76;
}

.campus-scroll,
.chip-scroll {
  width: 100%;
  margin-top: 22rpx;
  white-space: nowrap;
}

.campus-row,
.chip-row {
  display: inline-flex;
  gap: 12rpx;
  min-width: 100%;
}

.campus,
.area-chip,
.meal,
.score-dot {
  min-height: 64rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e1e8e4;
  border-radius: 999rpx;
  background: #f7faf8;
  color: #5d6c65;
  text-align: center;
  line-height: 64rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.campus.active,
.area-chip.active,
.meal.active,
.score-dot.active {
  border-color: #18a058;
  background: #18a058;
  color: #ffffff;
}

.campus:active,
.area-chip:active,
.meal:active,
.score-dot:active {
  opacity: .78;
}
