.padded {
  padding: 24rpx;
}

.area-name {
  margin: 18rpx 0 10rpx;
  font-size: 40rpx;
}

.add-row {
  margin-top: 22rpx;
}

.shop-card {
  overflow: hidden;
}

.shop-title {
  color: #17201c !important;
  font-size: 34rpx !important;
  font-weight: 900 !important;
}

.shop-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.shop-body {
  padding: 0 24rpx 22rpx;
}

.tag-row {
  margin-top: 14rpx;
}

.desc {
  margin-top: 12rpx;
}

.sheet {
  padding: 30rpx 28rpx 38rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.field-label {
  margin: 24rpx 0 10rpx;
  color: #17201c;
  font-weight: 900;
}

.modal-image {
  width: 188rpx;
  height: 188rpx;
  border-radius: 18rpx;
  background: #eef2ef;
}

.image-actions,
.sheet-actions {
  margin-top: 18rpx;
}
