.shop-cover-card {
  overflow: hidden;
  margin-bottom: 22rpx;
  border: 1rpx solid #e4ece7;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(23, 32, 28, 0.04);
}

.shop-image {
  width: 100%;
  height: 340rpx;
  background: #eef4f0;
}

.shop-image:active,
.comment-image:active {
  opacity: .86;
}

.shop-info {
  padding: 24rpx;
}

.shop-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin: 18rpx 0 12rpx;
}

.shop-name {
  flex: 1;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.25;
}

.shop-score {
  color: #18a058;
  font-size: 40rpx;
  font-weight: 900;
}

.desc {
  margin-top: 12rpx;
}

.shop-actions {
  margin-top: 22rpx;
}

.item-card {
  padding-bottom: 4rpx;
}

.item-cell-title {
  color: #b01f24 !important;
  font-size: 36rpx !important;
  font-weight: 900 !important;
  line-height: 1.25 !important;
}

.item-status {
  color: #d03050 !important;
  font-weight: 800 !important;
}

.item-body {
  padding: 0 24rpx 24rpx;
}

.item-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.stat-pill {
  min-width: 0;
  padding: 16rpx 12rpx;
  border: 1rpx solid #e2ebe6;
  border-radius: 18rpx;
  background: #f8fbf9;
  text-align: center;
}

.stat-pill text {
  display: block;
  color: #718078;
  font-size: 22rpx;
  font-weight: 700;
}

.stat-pill strong {
  display: block;
  margin-top: 4rpx;
  color: #17201c;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.2;
}

.item-desc {
  margin-top: 16rpx;
}

.item-action-row {
  margin-top: 18rpx;
}

.danger-dot {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  min-width: 34rpx;
  border: 1rpx solid #ffd4d2;
  border-radius: 999rpx;
  background: #fff3f2;
  color: #d03050;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 30rpx;
  box-sizing: border-box;
}

.danger-dot:active {
  transform: scale(.92);
  opacity: .78;
}

.comment-card {
  padding-bottom: 20rpx;
}

.comment-user {
  font-size: 30rpx !important;
  font-weight: 900 !important;
}

.comment-side {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.comment-score {
  color: #18a058;
  font-size: 24rpx;
  font-weight: 900;
}

.comment-text {
  padding: 4rpx 24rpx 16rpx;
  font-size: 33rpx;
  line-height: 1.65;
  white-space: pre-wrap;
}

.comment-image {
  width: calc(100% - 48rpx);
  height: 360rpx;
  margin: 0 24rpx;
  border-radius: 18rpx;
  background: #eef2ef;
}

.sheet {
  max-height: 90vh;
  overflow-y: auto;
  padding: 30rpx 28rpx 38rpx;
  box-sizing: border-box;
  background: #ffffff;
}

.field-label {
  margin: 24rpx 0 10rpx;
  color: #17201c;
  font-weight: 900;
}

.sheet .textarea {
  margin-top: 20rpx;
}

.modal-image {
  width: 188rpx;
  height: 188rpx;
  border-radius: 18rpx;
  background: #eef2ef;
}

.image-actions,
.sheet-actions {
  margin-top: 18rpx;
}

.segmented {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8rpx;
  margin-top: 20rpx;
  padding: 8rpx;
  border: 1rpx solid #dfe9e4;
  border-radius: 999rpx;
  background: #f5faf7;
}

.segmented view {
  min-height: 60rpx;
  border-radius: 999rpx;
  color: #63746c;
  text-align: center;
  line-height: 60rpx;
  font-weight: 800;
}

.segmented .active {
  color: #ffffff;
  background: #18a058;
}
