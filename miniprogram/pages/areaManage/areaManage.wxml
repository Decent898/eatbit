<view class="page">
  <view class="van-card padded">
    <view class="title">{{editMode ? '修改区域' : '新建区域'}}</view>
    <view class="muted">区域是外层结构，比如食堂、宿舍楼下或商业区。</view>
    <view class="field">
      <view class="field-label">区域名称</view>
      <view class="field-example">例如：北食堂、甘棠园5B</view>
      <input class="input" data-key="name" value="{{name}}" bindinput="bindInput" placeholder="填写区域名称" />
    </view>
    <view class="field">
      <view class="field-label">校区</view>
      <scroll-view class="campus-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
        <view class="campus-row">
          <view class="campus {{campus === '良乡校区' ? 'active' : ''}}" data-value="良乡校区" bindtap="setCampus">良乡</view>
          <view class="campus {{campus === '中关村校区' ? 'active' : ''}}" data-value="中关村校区" bindtap="setCampus">中关村</view>
        </view>
      </scroll-view>
    </view>
    <view class="field">
      <view class="field-label">类型</view>
      <picker mode="selector" range="{{kinds}}" bindchange="onKind">
        <view class="select kind-select">{{kind}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="field-label">区域说明</view>
      <view class="field-example">可不填，后续也能再补</view>
      <textarea class="textarea" data-key="description" value="{{description}}" bindinput="bindInput" placeholder="填写区域说明" />
    </view>
    <view class="button-row right actions">
      <van-button wx:if="{{editMode}}" round plain type="default" bindtap="resetForm">取消</van-button>
      <van-button round type="primary" bindtap="submit">{{editMode ? '保存修改' : '创建区域'}}</van-button>
    </view>
  </view>

  <view class="section-title">现有区域</view>
  <view wx:for="{{areas}}" wx:key="id" class="van-card area-card">
    <van-cell title="{{item.name}}" label="{{item.campus}} · {{item.kind}}" title-class="area-title">
      <van-button slot="right-icon" round size="small" plain type="primary" data-id="{{item.id}}" bindtap="editArea">修改</van-button>
    </van-cell>
    <view wx:if="{{item.description}}" class="muted desc">{{item.description}}</view>
  </view>
</view>
