{
  "name": "bit-food-forum",
  "private": false,
  "version": "0.1.0",
  "license": "MIT",
  "description": "Open-source BIT campus food forum for web and WeChat mini program.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "pages:dev": "npm run build && wrangler pages dev dist",
    "db:migrate:local": "wrangler d1 migrations apply bit-food-forum --local",
    "db:migrate:remote": "wrangler d1 migrations apply bit-food-forum --remote"
  },
  "dependencies": {
    "@vicons/material": "^0.12.0",
    "naive-ui": "^2.43.1",
    "vfonts": "^0.0.3",
    "vue": "^3.5.16",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "typescript": "^5.8.3",
    "vite": "6.3.5",
    "vue-tsc": "^2.2.10",
    "wrangler": "^4.98.0"
  }
}
